# Copy this file to .env before running `docker compose up --build`.
# Every value below is safe to commit — no real secrets, synthetic data only.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://medikiosk:medikiosk@db:5432/medikiosk

# --- Auth ---
# CHANGE THIS before any non-local deployment.
JWT_SECRET=change-me-in-.env
JWT_EXPIRE_MINUTES=480

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- AI provider selection ---
# "mock" (default) requires no API keys and is the only mode exercised by the
# test suite / evaluation script. Switch to "production" only after wiring a
# real vendor in backend/ai/providers/production_providers.py AND setting the
# corresponding *_API_KEY below.
SPEECH_PROVIDER=mock
OCR_PROVIDER=mock
NLP_PROVIDER=mock
SUMMARY_PROVIDER=mock
TRANSLATION_PROVIDER=mock

# ASR_API_KEY=
# TTS_API_KEY=
# OCR_API_KEY=
# NLP_API_KEY=
# LLM_API_KEY=
# TRANSLATION_API_KEY=

# --- Integrations (mock/sandbox only in this prototype — never claim
#     production ABDM/HIS connectivity unless actually configured/tested) ---
FHIR_MODE=mock
ABDM_MODE=sandbox
HIS_MODE=mock

# --- Environment ---
ENV=development

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
