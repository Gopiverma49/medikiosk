{
  "name": "medikiosk-platform",
  "version": "0.1.0",
  "private": true,
  "description": "MediKiosk Clinical Intake & Physician Workflow Suite",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 --app-dir backend",
    "seed": "python -m app.seed --app-dir backend",
    "build:frontend": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
